import tensorflow as tf

def create_example():
    feature = {
        'video': tf.train.Feature(float_list=tf.train.FloatList(value=[0.1, 0.2, 0.3])),
        'audio': tf.train.Feature(float_list=tf.train.FloatList(value=[0.4, 0.5, 0.6])),
        'text': tf.train.Feature(bytes_list=tf.train.BytesList(value=[b"sample text"]))
    }
    return tf.train.Example(features=tf.train.Features(feature=feature))

with tf.io.TFRecordWriter('vatt/data/toy_dataset.tfrecord') as writer:
    writer.write(create_example().SerializeToString())
